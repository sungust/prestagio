# Copy to .env.local for local development. Never commit real values.

# Canonical origin used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://prestagio.com

# Privacy-conscious analytics (optional). Events are sent with navigator.sendBeacon,
# without cookies, identifiers or personal data. Leave empty to disable.
# Works with a Plausible-compatible endpoint, e.g. https://plausible.io/api/event
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_DOMAIN=prestagio.com

# Transactional email for "send my escape" and the contact form (server-only).
# Resend (https://resend.com) API key. Without it, email features explain they are
# unavailable and offer the share link / mailto fallback instead.
RESEND_API_KEY=
EMAIL_FROM="Prestagio <escapes@prestagio.com>"
CONTACT_TO=hello@prestagio.com

# Newsletter provider webhook for the separate marketing opt-in (server-only, optional).
NEWSLETTER_WEBHOOK_URL=

# Optional AI enhancement for escape write-ups (server-only). The Planner works
# fully without it using deterministic curated rules.
ANTHROPIC_API_KEY=
AI_ENHANCEMENT_ENABLED=false
AI_DAILY_REQUEST_CAP=200
ANTHROPIC_MODEL=claude-opus-5

# Prestagio Studio (Decap CMS at /admin): GitHub OAuth app credentials (server-only).
# Callback URL: https://prestagio.com/api/decap/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Content gate override: "production" shows only published content; "preview" also shows items in review.
# Defaults: Vercel production → production; everything else → preview.
CONTENT_STAGE=
